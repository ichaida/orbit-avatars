{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orbit-avatars",
  "compatibility_date": "2026-10-13",
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./site-dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "orbitavatars.chaida.dev",
      "custom_domain": true
    }
  ]
}
