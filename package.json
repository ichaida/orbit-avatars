{
  "name": "@ichaida/orbit-avatars",
  "version": "0.1.0",
  "description": "Friendly, customizable SVG avatars with a dependency-free TypeScript core and optional React component.",
  "license": "MIT",
  "author": "Ismail Chaida",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.5",
  "homepage": "https://orbitavatars.chaida.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ichaida/orbit-avatars.git"
  },
  "bugs": {
    "url": "https://github.com/ichaida/orbit-avatars/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "avatars",
    "svg",
    "typescript",
    "react",
    "avatar-generator",
    "hijab"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:site": "vite build",
    "dev": "vite --host 127.0.0.1 --port 4179",
    "preview": "vite preview --host 127.0.0.1 --port 4179",
    "test": "bun test ./test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src test site *.json *.ts *.md .github/workflows/*.yml",
    "format:check": "prettier --check src test site *.json *.ts *.md .github/workflows/*.yml",
    "check": "bun run typecheck && bun run test && bun run format:check",
    "prepare": "tsc -p tsconfig.build.json",
    "deploy": "bun run build:site && wrangler deploy"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  }
}
